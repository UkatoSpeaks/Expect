{
  "name": "Xpect",
  "description": "Pre-match home/draw/away probabilities for Premier League matches, built only from information available before kick-off. Bookmaker odds are a benchmark, never a model input.",
  "model": {
    "blend": "0.5 x logistic regression + 0.5 x Dixon-Coles",
    "logistic_regression": {
      "features": "Elo ratings, rolling form (last 5/10 matches: points, goals, shots, shots on target, corners), venue form, head-to-head, rest days, promoted-team and no-crowd flags",
      "C": 0.003,
      "trained_from": "2001/02"
    },
    "dixon_coles": {
      "time_decay_xi_per_day": 0.002,
      "window_days": 1825,
      "ridge": 2.0
    },
    "elo": {
      "k": 20.0,
      "home_adv": 0.0,
      "regress": 0.0,
      "gd_multiplier": true,
      "base": 1500.0
    },
    "frozen": "src/config.py; unchanged after looking at test or forward results",
    "market_benchmark": "closing 1X2 odds from football-data.co.uk, margin removed proportionally"
  },
  "data_sources": [
    {
      "name": "football-data.co.uk",
      "url": "https://www.football-data.co.uk/englandm.php"
    },
    {
      "name": "FPL-Core-Insights",
      "url": "https://github.com/olbauday/FPL-Core-Insights"
    }
  ],
  "evaluation": {
    "protocol": "walk-forward: each season predicted by a model trained on all earlier seasons; differences are model minus market (or minus LR) with 95% paired bootstrap CIs; negative = model better",
    "cv": {
